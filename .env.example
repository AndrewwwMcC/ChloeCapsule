# Settings for the deployed site (Railway → the app service → Variables).
# Copy the lines you need; the ${{...}} ones are filled in by Railway itself.
# For running on your own computer use run-local.cmd instead — it needs none of this,
# and personal bits like BIRTH_DATE go in local.env (gitignored).

# --- database and bucket ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
BUCKET=${{Bucket.BUCKET}}
ENDPOINT=${{Bucket.ENDPOINT}}
ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
REGION=${{Bucket.REGION}}
# S3_ADDRESSING_STYLE=path   # only if the bucket's Credentials tab says path-style

# --- the album ---
SITE_NAME=Chloé
TIMEZONE=Europe/Vienna
# Her date of birth, YYYY-MM-DD. Turns on the age in the Home masthead ("Age 2 years,
# 6 months") and the "age 2" captions. Leave it out and all age text simply disappears.
BIRTH_DATE=2023-04-02

# --- access ---
# One password for the whole site. It grants everything: viewing, uploading,
# deleting, covers and the full download. Make it long and don't reuse it.
SITE_PASSWORD=<long, just for the two of us>
# Session cookies are signed with this plus SITE_PASSWORD, so changing the password
# logs every device out on its own.
SESSION_SECRET=<random string, 40+ characters>
# Upload-only, for the iPhone Shortcut. Never the site password.
SHORTCUT_TOKEN=<another random string>

# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
